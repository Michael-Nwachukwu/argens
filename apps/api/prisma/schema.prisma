generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String        @id @default(cuid())
  email                   String        @unique
  passwordHash            String
  emailVerified           Boolean       @default(false)
  emailVerificationToken  String?       @unique
  emailVerificationExpiry DateTime?
  passwordResetToken      String?       @unique // raw single-use reset token; cleared on use
  passwordResetExpiry     DateTime?     // reset token expiry (1h); null = no active reset
  transferPinHash         String?       // bcrypt hash of 4-digit transfer PIN; null = no PIN set
  accessCodeId            String?       @unique // the AccessCode redeemed at signup, if any
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  wallet                  Wallet?
  apiKeys                 ApiKey[]
  policies                Policy?
  transactions            Transaction[]
  auditLogs               AuditLog[]
  marketplaceSettings     MarketplaceServiceSetting[]
  creditGrants            CreditGrant[]
}

model Wallet {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id])
  stellarPublicKey    String        @unique
  stellarSecretKeyEnc String
  status              WalletStatus  @default(INITIALISING)
  balanceCache        Decimal       @default(0) @db.Decimal(18, 7)
  balanceCachedAt     DateTime?
  // Lifetime credits granted (analytics only). Active balance is computed from non-expired CreditGrant rows.
  creditsGranted      Decimal       @default(0) @db.Decimal(18, 7)
  createdAt           DateTime      @default(now())
  transactions        Transaction[]
}

enum WalletStatus {
  INITIALISING
  TRUSTLINE_PENDING
  READY
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  keyHash    String    @unique
  keyPrefix  String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Policy {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  allowanceLimit      Decimal? @db.Decimal(18, 7)
  maxTransactionLimit Decimal? @db.Decimal(18, 7)
  approvalThreshold   Decimal? @db.Decimal(18, 7)
  totalSpent          Decimal  @default(0) @db.Decimal(18, 7)
  sorobanContractId   String?
  updatedAt           DateTime @updatedAt
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  walletId          String
  wallet            Wallet            @relation(fields: [walletId], references: [id])
  stellarTxHash     String?
  recipientAddress  String
  amount            Decimal           @db.Decimal(18, 7)
  currency          String            @default("USDC")
  status            TransactionStatus
  type              String            @default("payment")  // "payment" | "marketplace"
  serviceId         String?           // null for direct payments
  serviceEndpoint   String?           // null for direct payments
  costPaid          Decimal?          @db.Decimal(18, 7)   // marketplace: marked-up amount charged to user
  memo              String?
  metadata          Json?
  policyResult      Json?
  blockedReason     String?
  destinationChain  String?
  destinationTxHash String?
  crossChain        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  approvalQueue     ApprovalQueue?
}

enum TransactionStatus {
  SUCCESS
  BLOCKED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FAILED
}

model ApprovalQueue {
  id            String         @id @default(cuid())
  transactionId String         @unique
  transaction   Transaction    @relation(fields: [transactionId], references: [id])
  userId        String
  status        ApprovalStatus @default(PENDING)
  token         String         @unique
  expiresAt     DateTime
  actedAt       DateTime?
  createdAt     DateTime       @default(now())
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventType String
  eventData Json
  createdAt DateTime @default(now())
}

model MarketplaceServiceSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  serviceId String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serviceId])
  @@index([userId])
}

// Global (platform-wide) marketplace kill-switch, keyed by provider id.
// Absence of a row = provider is enabled. Admin writes a row only to PAUSE a
// provider (enabled = false), e.g. when it's broken upstream. A paused provider
// is hidden from GET /marketplace/services and rejected by POST /marketplace/call,
// overriding any per-user MarketplaceServiceSetting.
model GlobalServiceSetting {
  id         String   @id @default(cuid())
  providerId String   @unique           // provider key, e.g. "exa", "alchemy"
  enabled    Boolean  @default(true)
  note       String?                     // admin context: why paused
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// Beta access codes — floating, single-use. Admin issues; user redeems at signup.
model AccessCode {
  id          String    @id @default(cuid())
  code        String    @unique             // e.g. "argns_beta_a3f9k2"
  note        String?                       // admin context: who it was issued to
  expiresAt   DateTime?
  redeemedBy  String?   @unique             // User.id once redeemed
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// Argens credit grants — prepaid marketplace budget, non-withdrawable, expirable.
// Each grant tracks its own remaining balance. Active credits balance =
// SUM(amountRemaining) WHERE expiresAt IS NULL OR expiresAt > now.
// Consumption is FIFO by expiresAt ASC (soonest to expire first).
model CreditGrant {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  amount          Decimal   @db.Decimal(18, 7) // amount originally granted
  amountRemaining Decimal   @db.Decimal(18, 7) // unused portion
  reason          String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([userId, expiresAt])
}
