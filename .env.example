# Argens API — environment template
#
# Copy to apps/api/.env and fill in. Every variable below is read somewhere in
# apps/api/src; nothing here is decorative. Variables marked REQUIRED will break
# startup or a core flow if unset.
#
#   cp .env.example apps/api/.env

# ─── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. Read by Prisma. `docker compose up -d postgres` serves this default.
DATABASE_URL="postgresql://argens:argens_dev@localhost:5432/argens"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-32-plus-char-random-string-openssl-rand-hex-32"

# Token lifetime. 1h is the deliberate V1 choice — short-lived tokens paired with
# the dashboard's 5-minute tab-idle logout. Do not lengthen this without revisiting
# that pairing. Code default if unset: 1h.
JWT_EXPIRES_IN="1h"

# ─── Encryption ───────────────────────────────────────────────────────────────
# REQUIRED. AES-256-GCM key for user Stellar secret keys. Must be 64 hex chars
# (= 32 bytes). Generate with: openssl rand -hex 32
#
# ⚠️ Changing this without re-encrypting every Wallet.stellarSecretKeyEnc row makes
#    every existing wallet permanently unsignable. Use a fresh key per environment —
#    never reuse a testnet key on mainnet.
ENCRYPTION_KEY="replace-with-64-char-hex-string"

# ─── Stellar ──────────────────────────────────────────────────────────────────
# REQUIRED. The single network toggle for the whole system. Never hardcode network
# values anywhere else. On testnet, wallet bootstrap uses friendbot and no ops
# wallet is needed.
STELLAR_NETWORK="mainnet"

# NOTE: there is no HORIZON_URL variable. The Horizon endpoint is derived from
# STELLAR_NETWORK in services/stellar.ts (mainnet → horizon.stellar.org,
# testnet → horizon-testnet.stellar.org). Setting it in the environment does nothing.

# REQUIRED. Not optional despite Soroban being dropped as a policy engine — the
# x402 marketplace client (services/mpp-client.ts) uses it to simulate and build
# SEP-41 USDC transfers. Must match STELLAR_NETWORK.
#   mainnet → https://mainnet.sorobanrpc.com
#   testnet → https://soroban-testnet.stellar.org
SOROBAN_RPC_URL="https://mainnet.sorobanrpc.com"

# ─── Argens-operated wallets ──────────────────────────────────────────────────
# Four platform wallets, all plain Stellar/EVM keypairs. Each fails SILENTLY when
# it runs dry — balance alerting is not optional in production.
# GET /v1/admin/wallets reports all four.

# Ops wallet (XLM) — funds 1.5 XLM of reserves per new user wallet on signup
# (1 XLM account reserve + 0.5 XLM trustline reserve).
# REQUIRED on mainnet. Leave empty on testnet — bootstrap falls back to friendbot.
# Empty on mainnet ⇒ every new signup fails at wallet bootstrap.
ARGENS_OPS_WALLET_SECRET=""
ARGENS_OPS_WALLET_PUBLIC=""

# Fee wallet (USDC) — Argens revenue. Receives the 20% marketplace markup and the
# CCTP cross-chain fee. Direct Stellar payments pay NO fee and never touch this.
# REQUIRED for marketplace calls: POST /marketplace/call returns 500
# FEE_WALLET_NOT_CONFIGURED without it. Must have a USDC trustline established.
ARGENS_FEE_WALLET=""

# Credit pool (USDC) — funds marketplace calls made against admin-granted credits.
# Optional: with no secret set, users holding credits transparently fall back to
# paying from their own USDC wallet.
ARGENS_CREDIT_POOL_SECRET=""
ARGENS_CREDIT_POOL_PUBLIC=""

# Base relayer (ETH) — pays gas to relay CCTP mints on Base.
# REQUIRED for cross-chain payments to 0x… recipients; without it the Stellar burn
# succeeds and the Base mint never lands.
ARGENS_BASE_RELAYER_SECRET=""

# ─── Cross-chain (CCTP V2) ────────────────────────────────────────────────────
# Optional. Defaults shown are the public endpoints used when unset. Set your own
# for rate-limit headroom.
BASE_RPC_URL="https://mainnet.base.org"
BASE_TESTNET_RPC_URL="https://sepolia.base.org"

# ─── Marketplace ──────────────────────────────────────────────────────────────
# Optional. Defaults to https://apiserver.mpprouter.dev when unset.
MPP_ROUTER_BASE_URL="https://apiserver.mpprouter.dev"

# ─── Email ────────────────────────────────────────────────────────────────────
# resend   → real delivery (needs RESEND_API_KEY + a verified sending domain)
# ethereal → throwaway test inbox, preview URL logged to console. Use locally.
# Defaults to ethereal when unset.
EMAIL_PROVIDER="ethereal"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@argens.xyz"

# Optional. Redirects ALL outbound mail to one inbox so you can exercise email
# flows without mailing real users. Ignored when NODE_ENV=production.
RESEND_DEV_OVERRIDE_TO=""

# ─── Admin / ops ──────────────────────────────────────────────────────────────
# Gates every /v1/admin/* route, checked against the `x-admin-secret` header.
# Unset ⇒ all admin routes return 503 ADMIN_DISABLED. Generate with:
#   openssl rand -hex 32
ADMIN_SECRET=""

# Recipient for operator alerts: low wallet balances, marketplace refund-needed.
# Unset ⇒ balance alerting is disabled and logs a warning at startup.
ADMIN_ALERT_EMAIL=""

# Balance alert floors. Checked every 6h; one email per wallet per 24h.
#   Ops XLM:      50     (≈ 33 signups at 1.5 XLM each)
#   Credit pool:  10     USDC
#   Fee USDC:     0      (alert only when empty / no trustline — this wallet receives, it does not drain)
#   Relayer ETH:  0.001  (covers ~1,000 Base CCTP mints at the observed ~0.00000093 ETH/mint; buffer for L1 fee spikes)
XLM_ALERT_THRESHOLD_OPS="50"
USDC_ALERT_THRESHOLD_POOL="10"
USDC_ALERT_THRESHOLD_FEE="0"
ETH_ALERT_THRESHOLD_RELAYER="0.001"

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV="development"

# CORS origin whitelist. Never "*" in production.
FRONTEND_URL="http://localhost:3000"

# Public web origin used to build links in emails and per-provider skill.md files.
# Defaults to https://argens.xyz. WEB_URL is accepted as a legacy fallback.
ARGENS_WEB_URL="http://localhost:3000"
