# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://argens:argens_dev@localhost:5432/argens"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-32-plus-char-random-string-openssl-rand-hex-32"
JWT_EXPIRES_IN="7d"

# ─── Encryption (AES-256-GCM for Stellar secret keys) ────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-char-hex-string"

# ─── Stellar ──────────────────────────────────────────────────────────────────
STELLAR_NETWORK="mainnet"
HORIZON_URL="https://horizon.stellar.org"
SOROBAN_RPC_URL="https://mainnet.sorobanrpc.com"

# Ops wallet — funds new user accounts with 1.5 XLM on signup (mainnet only).
# Mainnet requires an ops wallet secret for wallet bootstrap.
ARGENS_OPS_WALLET_SECRET=""
ARGENS_OPS_WALLET_PUBLIC=""

# Fee wallet — receives 0.5% USDC fee on every payment.
# MUST have a USDC trustline established before any payment is processed.
ARGENS_FEE_PERCENT="0.005"
ARGENS_FEE_WALLET=""

# ─── Email ────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=resend  → uses Resend (requires RESEND_API_KEY + verified domain)
# EMAIL_PROVIDER=ethereal → generates a free test inbox, logs preview URL to console
EMAIL_PROVIDER="ethereal"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@argens.xyz"

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
